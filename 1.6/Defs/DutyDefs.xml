<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DutyDef>
    <defName>RB_P0_HoldPost</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_AIDefendPoint">
          <targetAcquireRadius>6</targetAcquireRadius>
          <targetKeepRadius>8</targetKeepRadius>
          <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
        </li>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>4</maxDistToSquadFlag>
          <subNodes>
            <li Class="ThinkNode_Subtree">
              <treeDef>SatisfyBasicNeeds</treeDef>
            </li>
          </subNodes>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation">
          <locomotionUrgencyOutsideRadius>Sprint</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P0_WorkSettlement</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.JobGiver_P0SettlementWork" />
        <li Class="ThinkNode_Subtree">
          <treeDef>SatisfyBasicNeeds</treeDef>
        </li>
        <li Class="JobGiver_WanderNearDutyLocation">
          <locomotionUrgencyOutsideRadius>Jog</locomotionUrgencyOutsideRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P3_DefendPost</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.JobGiver_P3DefendPost">
          <targetAcquireRadius>48</targetAcquireRadius>
          <targetKeepRadius>52</targetKeepRadius>
          <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
        </li>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>7</maxDistToSquadFlag>
          <subNodes>
            <li Class="RealisticBases.AI.ThinkNode_P5AwakePostNeeds">
              <subNodes><li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li></subNodes>
            </li>
          </subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P3HoldAssignedPost" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P3_ManMortar</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.JobGiver_P3ManMortar" />
        <li Class="RealisticBases.AI.ThinkNode_P5AwakePostNeeds">
          <subNodes><li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li></subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P3HoldAssignedPost" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P3_Support</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.JobGiver_P3Support" />
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>14</maxDistToSquadFlag>
          <subNodes><li Class="RealisticBases.AI.ThinkNode_P5AwakePostNeeds">
            <subNodes><li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li></subNodes>
          </li></subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P5BOffDutyWander" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P3_Relief</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.ThinkNode_P5BoundedNeeds">
          <subNodes>
            <li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li>
            <li Class="RealisticBases.AI.JobGiver_P5PatientBedRest" />
          </subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P5BOffDutyWander" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- No post and no rest: bounded native needs without sleep, then an idle
       wander near the pawn's own bed. Sleep needs the relief role. -->
  <DutyDef>
    <defName>RB_P3_OffDuty</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.ThinkNode_P5BoundedNeeds">
          <subNodes>
            <li Class="RealisticBases.AI.ThinkNode_P5AwakePostNeeds">
              <subNodes><li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li></subNodes>
            </li>
          </subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P5BOffDutyWander" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <DutyDef>
    <defName>RB_P3_InnerFallback</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="RealisticBases.AI.JobGiver_P3DefendPost">
          <targetAcquireRadius>32</targetAcquireRadius>
          <targetKeepRadius>36</targetKeepRadius>
          <needLOSToAcquireNonPawnTargets>true</needLOSToAcquireNonPawnTargets>
        </li>
        <li Class="ThinkNode_ForbidOutsideFlagRadius">
          <maxDistToSquadFlag>4</maxDistToSquadFlag>
          <subNodes><li Class="RealisticBases.AI.ThinkNode_P5AwakePostNeeds">
            <subNodes><li Class="ThinkNode_Subtree"><treeDef>SatisfyBasicNeeds</treeDef></li></subNodes>
          </li></subNodes>
        </li>
        <li Class="RealisticBases.AI.JobGiver_P3HoldAssignedPost" />
      </subNodes>
    </thinkNode>
  </DutyDef>
</Defs>
